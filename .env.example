# ================= Moments — Vercel 部署环境变量模板 =================
# 本地开发：复制为 .env（已 gitignore）并填入真实值。
# 生产部署：在 Vercel 项目 → Settings → Environment Variables 中逐条配置。

# ---------- 数据库（Neon Postgres，必需）----------
# 推荐：Vercel 项目 → Storage → Marketplace → Neon 一键开通并 Connect 后自动注入；
# 手动配置时填 Neon 控制台的 Pooled connection string（带 -pooler，适合 serverless）。
# 本地开发也可指向本地 Postgres：postgresql://postgres:postgres@localhost:5432/moments
DATABASE_URL=

# ---------- 会话（必需）----------
# 签发会话 JWT 的密钥，请用足够长的随机字符串（如 openssl rand -hex 32）
JWT_SECRET=replace-with-a-long-random-string
# JWT 有效期，例如 7d / 24h / 60m（默认 24h）
JWT_EXPIRES_IN=7d

# ---------- 对象存储（Vercel Blob，上传图片/视频必需）----------
# 在 Vercel 项目 → Storage → Blob 创建 store 后自动注入；
# 本地开发可 `vercel link && vercel env pull .env` 拉取。
BLOB_READ_WRITE_TOKEN=

# ---------- 短期 KV（Upstash Redis，邮件验证码必需）----------
# https://upstash.com 创建 Redis（REST API），或在 Vercel Marketplace 一键开通
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ---------- 邮件（Resend，注册/找回密码必需）----------
# https://resend.com → API Keys 创建；发件域名需在 Resend 验证（Domain → Add Domain），
# 快速体验可先用沙箱地址 onboarding@resend.dev（只能发给自己账号邮箱）。
# 发件人地址/显示名在管理后台（/config）的 mailFrom / mailName 中配置。
RESEND_API_KEY=

# ---------- Web Push（可选，浏览器推送通知）----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- 可选集成（留空禁用）----------
# reCAPTCHA v3 后端校验
RECAPTCHA_SECRET_KEY=
# 腾讯地图 Key（IP 归属地欢迎语）
TENCENT_MAP_KEY=

# ---------- 站点信息（可选）----------
# 站点对外 URL，用于邮件/跳转等绝对链接
SITE_URL=http://localhost:3000
SITE_NAME=Moments
